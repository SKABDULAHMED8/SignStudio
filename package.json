{
  "name": "signstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first signature extraction and local PDF signing studio",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "7.3.8"
  }
}
